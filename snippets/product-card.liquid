{% comment %}
  Renders a product card
  Accepts:
  - product_card_product: {Object} Product Liquid object
  - show_secondary_image: {Boolean} Show the secondary image on hover. Default: false
  - show_rating: {Boolean} Show product rating. Default: true
  - show_quick_add: {Boolean} Show quick add button. Default: true
{% endcomment %}

{%- liquid
  assign current_variant = product_card_product.selected_or_first_available_variant
  assign on_sale = false
  if product_card_product.compare_at_price > product_card_product.price
    assign on_sale = true
    assign discount_percent = product_card_product.compare_at_price | minus: product_card_product.price | times: 100.0 | divided_by: product_card_product.compare_at_price | round
  endif
-%}

<div class="product-card group" data-product-id="{{ product_card_product.id }}">
  <div class="product-card__media-wrapper relative overflow-hidden rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] aspect-square">
    {%- if on_sale -%}
      <div class="product-card__badge-sale absolute top-3 left-3 z-10 bg-[#E86B91] text-white text-[11px] font-bold px-2.5 py-1 rounded-full uppercase tracking-wider shadow-sm">
        -{{ discount_percent }}% OFF
      </div>
    {%- endif -%}

    <a href="{{ product_card_product.url }}" class="product-card__link block w-full h-full">
      {%- if product_card_product.featured_media != blank -%}
        <img
          src="{{ product_card_product.featured_media | image_url: width: 600 }}"
          alt="{{ product_card_product.featured_media.alt | escape | default: product_card_product.title }}"
          class="product-card__image w-full h-full object-contain p-4 transition-transform duration-500 group-hover:scale-105"
          loading="lazy"
          width="400"
          height="400"
        >
        {%- if show_secondary_image and product_card_product.media[1] != blank -%}
          <img
            src="{{ product_card_product.media[1] | image_url: width: 600 }}"
            alt="{{ product_card_product.title | escape }}"
            class="product-card__image-secondary absolute inset-0 w-full h-full object-contain p-4 opacity-0 transition-opacity duration-500 group-hover:opacity-100"
            loading="lazy"
            width="400"
            height="400"
          >
        {%- endif -%}
      {%- else -%}
        <div class="product-card__placeholder flex flex-col items-center justify-center w-full h-full bg-[#FFF0F4] text-[#E86B91]">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5">
            <rect width="18" height="18" x="3" y="3" rx="2"/>
            <circle cx="8.5" cy="8.5" r="1.5"/>
            <path d="m21 15-5-5L5 21"/>
          </svg>
        </div>
      {%- endif -%}
    </a>

    {%- if show_quick_add -%}
      <div class="product-card__quick-actions absolute bottom-3 inset-x-3 z-10 transition-all duration-300 opacity-0 translate-y-2 group-hover:opacity-100 group-hover:translate-y-0">
        {%- if current_variant.available -%}
          <button
            type="button"
            class="js-quick-add-btn w-full bg-[#111111] hover:bg-[#333333] text-white text-xs font-semibold py-2.5 px-4 rounded-xl shadow-md transition-colors flex items-center justify-center gap-2"
            data-variant-id="{{ current_variant.id }}"
          >
            <span>{{ 'sections.featured_collection.quick_add' | t | default: 'Agregar al Carrito' }}</span>
          </button>
        {%- else -%}
          <button type="button" class="w-full bg-gray-300 text-gray-600 text-xs font-semibold py-2.5 px-4 rounded-xl cursor-not-allowed" disabled>
            {{ 'sections.featured_collection.sold_out' | t | default: 'Agotado' }}
          </button>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>

  <div class="product-card__info mt-3.5 space-y-1.5">
    {%- if show_rating -%}
      <div class="product-card__rating flex items-center gap-1">
        <div class="flex text-[#FFB800]">
          {%- for i in (1..5) -%}
            {% render 'icon-star' %}
          {%- endfor -%}
        </div>
        <span class="text-xs text-gray-500 font-medium">(5.0)</span>
      </div>
    {%- endif -%}

    <h3 class="product-card__title text-sm font-bold text-gray-900 line-clamp-1 hover:text-[#E86B91] transition-colors">
      <a href="{{ product_card_product.url }}">
        {{ product_card_product.title }}
      </a>
    </h3>

    {%- if product_card_product.metafields.descriptors.subtitle != blank -%}
      <p class="text-xs text-gray-500 line-clamp-1">
        {{ product_card_product.metafields.descriptors.subtitle }}
      </p>
    {%- endif -%}

    <div class="product-card__price pt-1">
      {% render 'price', product: product_card_product %}
    </div>
  </div>
</div>
