{% comment %}
  Skin Concerns Problem-Solution Grid Section (Exact 1:1 Match to Design)
{% endcomment %}

<section class="skin-concerns py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
        {{ section.settings.tag | default: 'SOLUCIONES' }}
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight italic">
        {{ section.settings.heading | default: '¿Cuál es tu mayor preocupación?' }}
      </h2>
    </div>

    <!-- 5 Cards Responsive Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      <!-- Card 1 -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2 px-3 rounded-2xl shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-tight">
            Vellos encarnados
          </h3>
        </div>
      </div>

      <!-- Card 2 -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2 px-3 rounded-2xl shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-tight">
            Irritación y foliculitis
          </h3>
        </div>
      </div>

      <!-- Card 3 -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2 px-3 rounded-2xl shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-tight">
            Piel sensible
          </h3>
        </div>
      </div>

      <!-- Card 4 -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2 px-3 rounded-2xl shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-tight">
            Manchas oscuras
          </h3>
        </div>
      </div>

      <!-- Card 5 -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 col-span-2 sm:col-span-1">
        <div class="absolute inset-0 bg-gradient-to-t from-black/60 via-transparent to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2 px-3 rounded-2xl shadow-sm">
          <h3 class="text-xs sm:text-sm font-bold text-gray-900 leading-tight">
            Dolor por cera
          </h3>
        </div>
      </div>
    </div>

    <!-- Trust Statement -->
    <div class="text-center mt-12">
      <p class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#E86B91] bg-[#FFF0F4] inline-block px-6 py-2.5 rounded-full border border-[#F7D5DF]">
        {{ section.settings.bottom_statement | default: 'ÚNETE A MÁS DE 50,000+ MUJERES CON PIEL SUAVE Y LIBRE DE VELLOS' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin Concerns",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "SOLUCIONES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "¿Cuál es tu mayor preocupación?"
    },
    {
      "type": "text",
      "id": "bottom_statement",
      "label": "Bottom Statement",
      "default": "ÚNETE A MÁS DE 50,000+ MUJERES CON PIEL SUAVE Y LIBRE DE VELLOS"
    }
  ],
  "presets": [
    {
      "name": "Skin Concerns"
    }
  ]
}
{% endschema %}
