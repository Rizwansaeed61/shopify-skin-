{% comment %}
  Skin Concerns Problem-Solution Grid Section (Exact 1:1 Match to Design)
{% endcomment %}

<section class="skin-concerns py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
        {{ section.settings.tag | default: 'SOLUCIONES A TU MEDIDA' }}
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
        {{ section.settings.heading | default: '¿Cuál es tu mayor preocupación?' }}
      </h2>
    </div>

    <!-- 5 Cards Responsive Grid -->
    <div class="grid grid-cols-2 sm:grid-cols-3 lg:grid-cols-5 gap-4 sm:gap-6">
      <!-- Card 1: Facial Hair -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <img
          src="{{ 'concern-face.jpg' | asset_url }}"
          alt="Vello en el rostro"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
          width="300"
          height="400"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2.5 px-3 rounded-2xl shadow-md border border-white/40">
          <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 uppercase tracking-tight leading-tight">
            Vello en el rostro
          </h3>
        </div>
      </div>

      <!-- Card 2: Wax Pain -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <img
          src="{{ 'concern-wax.jpg' | asset_url }}"
          alt="Dolor con la cera"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
          width="300"
          height="400"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2.5 px-3 rounded-2xl shadow-md border border-white/40">
          <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 uppercase tracking-tight leading-tight">
            Dolor con la cera
          </h3>
        </div>
      </div>

      <!-- Card 3: Sensitive Skin -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <img
          src="{{ 'concern-sensitive.jpg' | asset_url }}"
          alt="Piel sensible o irritada"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
          width="300"
          height="400"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2.5 px-3 rounded-2xl shadow-md border border-white/40">
          <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 uppercase tracking-tight leading-tight">
            Piel sensible / rojeces
          </h3>
        </div>
      </div>

      <!-- Card 4: Ingrown Hairs -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <img
          src="{{ 'concern-ingrown.jpg' | asset_url }}"
          alt="Vellos encarnados"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
          width="300"
          height="400"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2.5 px-3 rounded-2xl shadow-md border border-white/40">
          <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 uppercase tracking-tight leading-tight">
            Vellos encarnados
          </h3>
        </div>
      </div>

      <!-- Card 5: Salon Costs / Lack of time -->
      <div class="concern-card group relative rounded-3xl overflow-hidden aspect-[3/4] bg-[#FFF0F4] border border-[#F7D5DF] shadow-md flex flex-col justify-end p-3 sm:p-4 col-span-2 sm:col-span-1 hover:shadow-xl transition-all duration-300 transform hover:-translate-y-1">
        <img
          src="{{ 'concern-salon.jpg' | asset_url }}"
          alt="Gasto excesivo en salones"
          class="absolute inset-0 w-full h-full object-cover transition-transform duration-700 group-hover:scale-110"
          loading="lazy"
          width="300"
          height="400"
        >
        <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/20 to-transparent z-0"></div>
        <div class="relative z-10 text-center bg-white/95 backdrop-blur-md py-2.5 px-3 rounded-2xl shadow-md border border-white/40">
          <h3 class="text-xs sm:text-sm font-extrabold text-gray-900 uppercase tracking-tight leading-tight">
            Gasto en salones
          </h3>
        </div>
      </div>
    </div>

    <!-- Trust Statement -->
    <div class="text-center mt-12 sm:mt-16">
      <p class="text-xs sm:text-sm font-extrabold uppercase tracking-widest text-[#E86B91] bg-[#FFF0F4] inline-block px-8 py-3 rounded-full border border-[#F7D5DF] shadow-sm">
        {{ section.settings.bottom_statement | default: '★ MÁS DE 50,000 MUJERES SATISFECHAS EN TODO EL PAÍS DISFRUTAN DE UNA PIEL SUAVE' }}
      </p>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Skin Concerns",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "SOLUCIONES A TU MEDIDA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "¿Cuál es tu mayor preocupación?"
    },
    {
      "type": "text",
      "id": "bottom_statement",
      "label": "Bottom Statement",
      "default": "★ MÁS DE 50,000 MUJERES SATISFECHAS EN TODO EL PAÍS DISFRUTAN DE UNA PIEL SUAVE"
    }
  ],
  "presets": [
    {
      "name": "Skin Concerns"
    }
  ]
}
{% endschema %}
