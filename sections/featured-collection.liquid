{% comment %}
  Featured Collection / Cross-Sell Carousel Section (Exact 1:1 Match to Design)
{% endcomment %}

<section class="featured-collection py-16 md:py-24 bg-white" data-carousel-container>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Arrow Controls -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
          {{ section.settings.tag | default: 'RUTINA COMPLETA' }}
        </span>
        <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {{ section.settings.heading | default: 'Complementa tu depilación' }}
        </h2>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-prev
          aria-label="Anterior"
        >
          {% render 'icon-arrow-left' %}
        </button>
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-next
          aria-label="Siguiente"
        >
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>

    <!-- Product Track / Grid -->
    <div
      class="flex gap-6 overflow-x-auto no-scrollbar pb-6 scroll-smooth"
      data-carousel-track
    >
      {%- assign collection = section.settings.collection -%}
      {%- if collection != blank and collection.products_count > 0 -%}
        {%- for product in collection.products limit: section.settings.products_to_show -%}
          <div class="w-64 sm:w-72 flex-shrink-0">
            {% render 'product-card', product_card_product: product, show_secondary_image: true, show_rating: true, show_quick_add: true %}
          </div>
        {%- endfor -%}
      {%- else -%}
        <!-- Product 1: Combo Kit -->
        <div class="w-64 sm:w-72 flex-shrink-0 product-card group">
          <div class="product-card__media-wrapper relative overflow-hidden rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] aspect-square flex items-center justify-center p-3">
            <div class="absolute top-3 left-3 bg-[#E86B91] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-sm">-30% OFF</div>
            <img src="{{ 'product-combo.jpg' | asset_url }}" alt="Combo Tratamiento Completo" class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy">
            <div class="product-card__quick-actions absolute bottom-3 inset-x-3 transition-all duration-300 opacity-0 group-hover:opacity-100">
              <a href="/collections/all" class="w-full bg-[#111111] hover:bg-[#333333] text-white text-xs font-semibold py-2.5 px-4 rounded-xl shadow-md transition-colors flex items-center justify-center">
                Ver Producto
              </a>
            </div>
          </div>
          <div class="product-card__info mt-3.5 space-y-1">
            <div class="flex items-center gap-1 text-[#FFB800]">
              {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
              <span class="text-xs text-gray-500 font-medium">(5.0)</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-gray-900 uppercase">COMBO TRATAMIENTO COMPLETO</h3>
            <p class="text-[11px] text-gray-500">Kit IPL + Gel Conductor + Loción Calmante</p>
            <div class="pt-1">
              <span class="font-bold text-gray-900 text-sm">$139.00</span>
              <s class="text-gray-400 text-xs ml-2">$199.00</s>
            </div>
          </div>
        </div>

        <!-- Product 2: Mini Shaver -->
        <div class="w-64 sm:w-72 flex-shrink-0 product-card group">
          <div class="product-card__media-wrapper relative overflow-hidden rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] aspect-square flex items-center justify-center p-3">
            <div class="absolute top-3 left-3 bg-[#E86B91] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-sm">-25% OFF</div>
            <img src="{{ 'product-shaver.jpg' | asset_url }}" alt="Mini Shaver Facial" class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy">
            <div class="product-card__quick-actions absolute bottom-3 inset-x-3 transition-all duration-300 opacity-0 group-hover:opacity-100">
              <a href="/collections/all" class="w-full bg-[#111111] hover:bg-[#333333] text-white text-xs font-semibold py-2.5 px-4 rounded-xl shadow-md transition-colors flex items-center justify-center">
                Ver Producto
              </a>
            </div>
          </div>
          <div class="product-card__info mt-3.5 space-y-1">
            <div class="flex items-center gap-1 text-[#FFB800]">
              {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
              <span class="text-xs text-gray-500 font-medium">(4.9)</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-gray-900 uppercase">MINI SHAVER DE PRECISIÓN FACIAL</h3>
            <p class="text-[11px] text-gray-500">Recortador de precisión para cejas y rostro</p>
            <div class="pt-1">
              <span class="font-bold text-gray-900 text-sm">$29.00</span>
              <s class="text-gray-400 text-xs ml-2">$39.00</s>
            </div>
          </div>
        </div>

        <!-- Product 3: Kit Repuestos & Gafas -->
        <div class="w-64 sm:w-72 flex-shrink-0 product-card group">
          <div class="product-card__media-wrapper relative overflow-hidden rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] aspect-square flex items-center justify-center p-3">
            <div class="text-6xl">🕶️</div>
            <div class="product-card__quick-actions absolute bottom-3 inset-x-3 transition-all duration-300 opacity-0 group-hover:opacity-100">
              <a href="/collections/all" class="w-full bg-[#111111] hover:bg-[#333333] text-white text-xs font-semibold py-2.5 px-4 rounded-xl shadow-md transition-colors flex items-center justify-center">
                Ver Producto
              </a>
            </div>
          </div>
          <div class="product-card__info mt-3.5 space-y-1">
            <div class="flex items-center gap-1 text-[#FFB800]">
              {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
              <span class="text-xs text-gray-500 font-medium">(5.0)</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-gray-900 uppercase">KIT PROTECCIÓN UV Y GAFAS IPL</h3>
            <p class="text-[11px] text-gray-500">Protección visual certificada para sesiones IPL</p>
            <div class="pt-1">
              <span class="font-bold text-gray-900 text-sm">$19.00</span>
            </div>
          </div>
        </div>

        <!-- Product 4: Body Scrub -->
        <div class="w-64 sm:w-72 flex-shrink-0 product-card group">
          <div class="product-card__media-wrapper relative overflow-hidden rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] aspect-square flex items-center justify-center p-3">
            <div class="absolute top-3 left-3 bg-[#E86B91] text-white text-[10px] font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wider shadow-sm">-25% OFF</div>
            <img src="{{ 'product-scrub.jpg' | asset_url }}" alt="Exfoliante Corporal" class="w-full h-full object-contain transition-transform duration-500 group-hover:scale-105" loading="lazy">
            <div class="product-card__quick-actions absolute bottom-3 inset-x-3 transition-all duration-300 opacity-0 group-hover:opacity-100">
              <a href="/collections/all" class="w-full bg-[#111111] hover:bg-[#333333] text-white text-xs font-semibold py-2.5 px-4 rounded-xl shadow-md transition-colors flex items-center justify-center">
                Ver Producto
              </a>
            </div>
          </div>
          <div class="product-card__info mt-3.5 space-y-1">
            <div class="flex items-center gap-1 text-[#FFB800]">
              {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
              <span class="text-xs text-gray-500 font-medium">(4.9)</span>
            </div>
            <h3 class="text-xs sm:text-sm font-bold text-gray-900 uppercase">EXFOLIANTE CORPORAL SUAVIZANTE</h3>
            <p class="text-[11px] text-gray-500">Con Fresa y Miel para prevenir vellos encarnados</p>
            <div class="pt-1">
              <span class="font-bold text-gray-900 text-sm">$24.00</span>
              <s class="text-gray-400 text-xs ml-2">$32.00</s>
            </div>
          </div>
        </div>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Featured Collection",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "RUTINA COMPLETA"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Complementa tu depilación"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Collection"
    },
    {
      "type": "range",
      "id": "products_to_show",
      "min": 4,
      "max": 12,
      "step": 1,
      "label": "Maximum products to show",
      "default": 6
    }
  ],
  "presets": [
    {
      "name": "Featured Collection"
    }
  ]
}
{% endschema %}
