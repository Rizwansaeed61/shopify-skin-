{% comment %}
  Blog Posts / Educational Articles 3-Column Section
{% endcomment %}

<section class="blog-posts py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="section-tag">{{ section.settings.tag | default: 'CONSEJOS Y GUÍAS' }}</span>
      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mt-2">
        {{ section.settings.heading | default: 'Descubre más' }}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-3">
        Aprende todo lo necesario para maximizar tus resultados y lucir una piel radiante.
      </p>
    </div>

    <!-- 3 Columns Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      {%- assign blog = section.settings.blog -%}
      {%- if blog != blank and blog.articles_count > 0 -%}
        {%- for article in blog.articles limit: 3 -%}
          <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-[#FFF8FA] card-shadow-hover">
            <div class="relative aspect-[16/10] overflow-hidden bg-[#FCEAEF]">
              {%- if article.image -%}
                <img
                  src="{{ article.image | image_url: width: 600 }}"
                  alt="{{ article.title | escape }}"
                  class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
                  width="400"
                  height="250"
                  loading="lazy"
                >
              {%- endif -%}
            </div>
            <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
              <div class="space-y-2">
                <span class="text-[11px] font-bold uppercase tracking-wider text-[#E86B91]">Guía de Cuidado</span>
                <h3 class="text-base sm:text-lg font-bold text-gray-900 line-clamp-2 group-hover:text-[#E86B91] transition-colors">
                  <a href="{{ article.url }}">{{ article.title }}</a>
                </h3>
                <p class="text-xs text-gray-600 line-clamp-3 leading-relaxed">
                  {{ article.excerpt_or_content | strip_html | truncatewords: 20 }}
                </p>
              </div>
              <a href="{{ article.url }}" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E86B91] group-hover:text-[#D43B65] uppercase tracking-wider">
                <span>Leer artículo</span>
                {% render 'icon-arrow-right', class: 'w-3.5 h-3.5' %}
              </a>
            </div>
          </article>
        {%- endfor -%}
      {%- else -%}
        <!-- Default 3 Educational Articles from Design -->
        <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-[#FFF8FA] card-shadow-hover">
          <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-tr from-[#FCEAEF] to-[#F8C8D8] flex items-center justify-center text-4xl">
            🧖‍♀️
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#E86B91]">Preparación</span>
              <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-[#E86B91] transition-colors">
                ¿Cómo preparar tu piel antes de tu sesión de depilación IPL?
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Descubre los cuidados previos esenciales para obtener los mejores resultados y evitar cualquier molestia o irritación.
              </p>
            </div>
            <a href="/blogs/news" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
              <span>Leer artículo</span>
              {% render 'icon-arrow-right', class: 'w-3.5 h-3.5' %}
            </a>
          </div>
        </article>

        <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-[#FFF8FA] card-shadow-hover">
          <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-tr from-[#FCEAEF] to-[#F8C8D8] flex items-center justify-center text-4xl">
            💡
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#E86B91]">Educación</span>
              <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-[#E86B91] transition-colors">
                Mitos y realidades sobre la depilación de luz pulsada en casa
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Desmentimos los mitos más comunes sobre la seguridad, eficacia y tonos de piel compatibles con dispositivos IPL.
              </p>
            </div>
            <a href="/blogs/news" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
              <span>Leer artículo</span>
              {% render 'icon-arrow-right', class: 'w-3.5 h-3.5' %}
            </a>
          </div>
        </article>

        <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-[#FFF8FA] card-shadow-hover">
          <div class="relative aspect-[16/10] overflow-hidden bg-gradient-to-tr from-[#FCEAEF] to-[#F8C8D8] flex items-center justify-center text-4xl">
            ✨
          </div>
          <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
            <div class="space-y-2">
              <span class="text-[11px] font-bold uppercase tracking-wider text-[#E86B91]">Zonas Específicas</span>
              <h3 class="text-base sm:text-lg font-bold text-gray-900 group-hover:text-[#E86B91] transition-colors">
                Guía paso a paso para resultados óptimos en axilas y bikini
              </h3>
              <p class="text-xs text-gray-600 leading-relaxed">
                Aprende cómo ajustar los niveles de potencia y frecuencia para las zonas más sensibles del cuerpo con total confort.
              </p>
            </div>
            <a href="/blogs/news" class="inline-flex items-center gap-1.5 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
              <span>Leer artículo</span>
              {% render 'icon-arrow-right', class: 'w-3.5 h-3.5' %}
            </a>
          </div>
        </article>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog / Educational",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Section Tag",
      "default": "CONSEJOS Y GUÍAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Descubre más"
    },
    {
      "type": "blog",
      "id": "blog",
      "label": "Blog to display"
    }
  ],
  "presets": [
    {
      "name": "Blog / Educational"
    }
  ]
}
{% endschema %}
