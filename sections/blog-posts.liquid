{% comment %}
  Blog Posts / Educational Articles 3-Column Section (Exact 1:1 Match to Design)
{% endcomment %}

<section class="blog-posts py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
        {{ section.settings.tag | default: 'CONSEJOS Y GUÍAS' }}
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
        {{ section.settings.heading | default: 'Descubre más' }}
      </h2>
    </div>

    <!-- 3 Columns Articles Grid -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8">
      <!-- Article 1 -->
      <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-white shadow-sm hover:shadow-lg transition-shadow">
        <div class="relative aspect-[16/10] overflow-hidden bg-[#FCEAEF]">
          <img
            src="{{ 'blog-underarm.jpg' | asset_url }}"
            alt="Cómo preparar tu piel"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width="400"
            height="250"
            loading="lazy"
          >
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <h3 class="text-sm sm:text-base font-extrabold text-gray-900 uppercase leading-snug group-hover:text-[#E86B91] transition-colors">
            ¿CÓMO PREPARAR TU PIEL ANTES DE TU SESIÓN DE DEPILACIÓN IPL?
          </h3>
          <a href="/blogs/news" class="inline-flex items-center gap-1 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
            <span>LEER MÁS</span>
            <span>→</span>
          </a>
        </div>
      </article>

      <!-- Article 2 -->
      <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-white shadow-sm hover:shadow-lg transition-shadow">
        <div class="relative aspect-[16/10] overflow-hidden bg-[#FCEAEF]">
          <img
            src="{{ 'blog-leg.jpg' | asset_url }}"
            alt="Mitos y realidades sobre depilación láser"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width="400"
            height="250"
            loading="lazy"
          >
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <h3 class="text-sm sm:text-base font-extrabold text-gray-900 uppercase leading-snug group-hover:text-[#E86B91] transition-colors">
            MITOS Y REALIDADES SOBRE LA DEPILACIÓN LÁSER EN CASA
          </h3>
          <a href="/blogs/news" class="inline-flex items-center gap-1 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
            <span>LEER MÁS</span>
            <span>→</span>
          </a>
        </div>
      </article>

      <!-- Article 3 -->
      <article class="blog-card group flex flex-col rounded-3xl overflow-hidden border border-[#F3E2E8] bg-white shadow-sm hover:shadow-lg transition-shadow">
        <div class="relative aspect-[16/10] overflow-hidden bg-[#FCEAEF]">
          <img
            src="{{ 'blog-white-handset.jpg' | asset_url }}"
            alt="Guía para axilas y bikini"
            class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
            width="400"
            height="250"
            loading="lazy"
          >
        </div>
        <div class="p-6 flex-1 flex flex-col justify-between space-y-4">
          <h3 class="text-sm sm:text-base font-extrabold text-gray-900 uppercase leading-snug group-hover:text-[#E86B91] transition-colors">
            GUÍA PASO A PASO PARA RESULTADOS ÓPTIMOS EN AXILAS Y BIKINI
          </h3>
          <a href="/blogs/news" class="inline-flex items-center gap-1 text-xs font-bold text-[#E86B91] uppercase tracking-wider">
            <span>LEER MÁS</span>
            <span>→</span>
          </a>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Blog / Educational",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "CONSEJOS Y GUÍAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Descubre más"
    }
  ],
  "presets": [
    {
      "name": "Blog / Educational"
    }
  ]
}
{% endschema %}
