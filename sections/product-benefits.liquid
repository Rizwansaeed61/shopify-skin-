{% comment %}
  Product Benefits Section (Exact 1:1 Match to Design)
{% endcomment %}

<section class="product-benefits py-16 md:py-24 bg-[#FFF7F9] relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
        {{ section.settings.tag | default: 'POR QUÉ ELEGIRNOS' }}
      </span>
      <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
        {{ section.settings.heading | default: 'Beneficios de ShinnySkin®' }}
      </h2>
    </div>

    <!-- 3-Column Layout: Left 2 Benefits | Center Handsets | Right 2 Benefits -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Column (Benefits 1 & 2) -->
      <div class="lg:col-span-4 space-y-8 order-2 lg:order-1">
        <!-- Benefit 1 -->
        <div class="p-6 rounded-3xl bg-white border border-[#F7D5DF] shadow-sm space-y-2 text-left">
          <div class="w-10 h-10 rounded-full bg-[#FFF0F4] text-[#E86B91] flex items-center justify-center font-bold text-lg mb-3 border border-[#F7D5DF]">
            💰
          </div>
          <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">
            AHORRO TOTAL
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Olvídate de pagar miles de dólares en clínicas. Una sola compra dura más de 10 años de uso continuo.
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="p-6 rounded-3xl bg-white border border-[#F7D5DF] shadow-sm space-y-2 text-left">
          <div class="w-10 h-10 rounded-full bg-[#FFF0F4] text-[#E86B91] flex items-center justify-center font-bold text-lg mb-3 border border-[#F7D5DF]">
            ✨
          </div>
          <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">
            PIEL SUAVE SIEMPRE
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Reduce visiblemente el crecimiento del vello hasta en un 95% sin dejar puntos negros ni vellos encarnados.
          </p>
        </div>
      </div>

      <!-- Center Handsets Presentation -->
      <div class="lg:col-span-4 flex justify-center items-center order-1 lg:order-2 my-6 lg:my-0">
        <div class="relative w-full max-w-xs aspect-square flex items-center justify-center">
          <div class="absolute inset-0 bg-[#FCEAEF] rounded-full filter blur-2xl transform scale-90"></div>
          {%- if section.settings.center_image != blank -%}
            <img
              src="{{ section.settings.center_image | image_url: width: 600 }}"
              alt="ShinnySkin Handset"
              class="relative z-10 w-full h-auto object-contain animate-float drop-shadow-xl"
              width="350"
              height="350"
              loading="lazy"
            >
          {%- else -%}
            <img
              src="{{ 'hero-handsets.jpg' | asset_url }}"
              alt="ShinnySkin Handsets"
              class="relative z-10 w-full h-auto object-contain rounded-2xl animate-float drop-shadow-xl"
              width="350"
              height="350"
              loading="lazy"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column (Benefits 3 & 4) -->
      <div class="lg:col-span-4 space-y-8 order-3">
        <!-- Benefit 3 -->
        <div class="p-6 rounded-3xl bg-white border border-[#F7D5DF] shadow-sm space-y-2 text-left">
          <div class="w-10 h-10 rounded-full bg-[#FFF0F4] text-[#E86B91] flex items-center justify-center font-bold text-lg mb-3 border border-[#F7D5DF]">
            🌸
          </div>
          <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">
            100% INDOLORO Y SEGURO
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Tecnología suave y probada dermatológicamente, ideal para axilas, piernas, rostro y área del bikini.
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="p-6 rounded-3xl bg-white border border-[#F7D5DF] shadow-sm space-y-2 text-left">
          <div class="w-10 h-10 rounded-full bg-[#FFF0F4] text-[#E86B91] flex items-center justify-center font-bold text-lg mb-3 border border-[#F7D5DF]">
            ⏱️
          </div>
          <h3 class="text-sm font-extrabold text-gray-900 uppercase tracking-wider">
            RÁPIDO Y FÁCIL
          </h3>
          <p class="text-xs text-gray-600 leading-relaxed">
            Tratamiento de cuerpo completo en menos de 20 minutos desde la comodidad y total privacidad de tu casa.
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom CTA Button -->
    <div class="mt-12 text-center">
      <a
        href="{{ section.settings.button_link | default: '/collections/all' }}"
        class="btn-primary px-10 py-4 text-xs font-bold uppercase tracking-wider bg-[#111111] hover:bg-[#333333] text-white rounded-full shadow-xl inline-flex items-center gap-2"
      >
        <span>{{ section.settings.button_text | default: 'COMPRAR AHORA' }}</span>
        {% render 'icon-arrow-right', class: 'w-4 h-4' %}
      </a>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Product Benefits",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "POR QUÉ ELEGIRNOS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Beneficios de ShinnySkin®"
    },
    {
      "type": "image_picker",
      "id": "center_image",
      "label": "Center Handsets Image"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "COMPRAR AHORA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Product Benefits"
    }
  ]
}
{% endschema %}
