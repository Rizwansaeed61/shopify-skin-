{% comment %}
  Product Benefits Section - Central Handset with 4 Benefits Flanking
{% endcomment %}

<section class="product-benefits py-16 md:py-24 bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16">
      <span class="section-tag">{{ section.settings.tag | default: 'POR QUÉ ELEGIRNOS' }}</span>
      <h2 class="font-heading text-3xl sm:text-4xl md:text-5xl font-extrabold text-gray-900 tracking-tight mt-2">
        {{ section.settings.heading | default: 'Beneficios de ShinnySkin' }}
      </h2>
      <p class="text-sm sm:text-base text-gray-600 mt-3">
        {{ section.settings.subheading | default: 'Diseñada con tecnología de grado clínico para que disfrutes de una depilación permanente sin dolor desde casa.' }}
      </p>
    </div>

    <!-- 3-Column Layout: Left 2 Benefits | Center Product Image | Right 2 Benefits -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 items-center">
      <!-- Left Column (Benefits 1 & 2) -->
      <div class="lg:col-span-4 space-y-8 order-2 lg:order-1">
        <!-- Benefit 1 -->
        <div class="p-6 rounded-3xl bg-[#FFF8FA] border border-[#F7D5DF] card-shadow-hover space-y-3 text-left">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F4] text-[#E86B91] border border-[#F7D5DF] flex items-center justify-center font-bold text-xl shadow-sm">
            💰
          </div>
          <h3 class="text-base font-extrabold text-gray-900 uppercase tracking-wide">
            {{ section.settings.b1_title | default: 'AHORRO TOTAL' }}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            {{ section.settings.b1_desc | default: 'Olvídate de pagar miles de dólares en costosas sesiones de clínicas láser. Una sola compra dura más de 10 años.' }}
          </p>
        </div>

        <!-- Benefit 2 -->
        <div class="p-6 rounded-3xl bg-[#FFF8FA] border border-[#F7D5DF] card-shadow-hover space-y-3 text-left">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F4] text-[#E86B91] border border-[#F7D5DF] flex items-center justify-center font-bold text-xl shadow-sm">
            ✨
          </div>
          <h3 class="text-base font-extrabold text-gray-900 uppercase tracking-wide">
            {{ section.settings.b2_title | default: 'PIEL SUAVE SIEMPRE' }}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            {{ section.settings.b2_desc | default: 'Reduce el crecimiento del vello corporal hasta en un 95% de forma visible y duradera sin irritación.' }}
          </p>
        </div>
      </div>

      <!-- Center Column (Handset Showcase) -->
      <div class="lg:col-span-4 flex justify-center items-center order-1 lg:order-2 my-6 lg:my-0">
        <div class="relative w-full max-w-xs aspect-square flex items-center justify-center">
          <div class="absolute inset-0 bg-[#FCEAEF] rounded-full filter blur-2xl transform scale-90"></div>
          {%- if section.settings.center_image != blank -%}
            <img
              src="{{ section.settings.center_image | image_url: width: 600 }}"
              alt="ShinnySkin Handset"
              class="relative z-10 w-full h-auto object-contain animate-float drop-shadow-xl"
              width="350"
              height="350"
              loading="lazy"
            >
          {%- else -%}
            <!-- Vector Illustration of Handsets -->
            <svg viewBox="0 0 400 400" class="relative z-10 w-full h-full drop-shadow-xl animate-float" fill="none">
              <ellipse cx="160" cy="190" rx="75" ry="115" fill="#E88A9F" stroke="#B84A65" stroke-width="2"/>
              <ellipse cx="230" cy="210" rx="75" ry="115" fill="#FFFFFF" stroke="#F0DFE5" stroke-width="3"/>
              <rect x="200" y="170" width="60" height="60" rx="15" fill="#111111"/>
              <circle cx="230" cy="260" r="14" fill="#E86B91"/>
            </svg>
          {%- endif -%}
        </div>
      </div>

      <!-- Right Column (Benefits 3 & 4) -->
      <div class="lg:col-span-4 space-y-8 order-3">
        <!-- Benefit 3 -->
        <div class="p-6 rounded-3xl bg-[#FFF8FA] border border-[#F7D5DF] card-shadow-hover space-y-3 text-left">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F4] text-[#E86B91] border border-[#F7D5DF] flex items-center justify-center font-bold text-xl shadow-sm">
            🌿
          </div>
          <h3 class="text-base font-extrabold text-gray-900 uppercase tracking-wide">
            {{ section.settings.b3_title | default: '100% INDOLORO Y SEGURO' }}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            {{ section.settings.b3_desc | default: 'Tecnología dermatológicamente probada, ideal para axilas, piernas, rostro y área de bikini sin quemaduras.' }}
          </p>
        </div>

        <!-- Benefit 4 -->
        <div class="p-6 rounded-3xl bg-[#FFF8FA] border border-[#F7D5DF] card-shadow-hover space-y-3 text-left">
          <div class="w-12 h-12 rounded-2xl bg-[#FFF0F4] text-[#E86B91] border border-[#F7D5DF] flex items-center justify-center font-bold text-xl shadow-sm">
            ⏱️
          </div>
          <h3 class="text-base font-extrabold text-gray-900 uppercase tracking-wide">
            {{ section.settings.b4_title | default: 'RÁPIDO Y FÁCIL' }}
          </h3>
          <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
            {{ section.settings.b4_desc | default: 'Trata todo tu cuerpo en menos de 20 minutos desde la comodidad y privacidad de tu habitación.' }}
          </p>
        </div>
      </div>
    </div>

    <!-- Bottom CTA Button -->
    <div class="mt-14 text-center">
      <a
        href="{{ section.settings.button_link | default: '/products/depiladora-ipl-pro' }}"
        class="btn-primary px-10 py-4 text-xs font-bold uppercase tracking-wider bg-[#111111] hover:bg-[#333333] text-white rounded-full shadow-xl inline-flex items-center gap-2"
      >
        <span>{{ section.settings.button_text | default: 'Obtener Mi ShinnySkin Ahora' }}</span>
        {% render 'icon-arrow-right', class: 'w-4 h-4' %}
      </a>
    </div>
  </div>
</section>

