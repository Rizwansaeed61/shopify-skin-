{% comment %}
  Hero Banner Section - High Impact IPL Showcase (Pixel-Perfect to Design)
{% endcomment %}

<section class="hero-banner relative overflow-hidden bg-gradient-to-b from-[#E6557E] via-[#D8426C] to-[#C73059] text-white py-12 md:py-16 lg:py-20">
  <!-- Multi-line repeating watermark background -->
  <div class="absolute inset-0 overflow-hidden pointer-events-none select-none opacity-15 flex flex-col justify-around py-4">
    <div class="text-[5rem] sm:text-[7rem] lg:text-[9rem] font-black uppercase text-white tracking-widest whitespace-nowrap leading-none transform -rotate-3 -translate-x-10">
      DEPILADORA IPL PRO
    </div>
    <div class="text-[5rem] sm:text-[7rem] lg:text-[9rem] font-black uppercase text-white tracking-widest whitespace-nowrap leading-none transform -rotate-3 -translate-x-4">
      DEPILADORA IPL PRO
    </div>
    <div class="text-[5rem] sm:text-[7rem] lg:text-[9rem] font-black uppercase text-white tracking-widest whitespace-nowrap leading-none transform -rotate-3 -translate-x-12">
      DEPILADORA IPL PRO
    </div>
    <div class="text-[5rem] sm:text-[7rem] lg:text-[9rem] font-black uppercase text-white tracking-widest whitespace-nowrap leading-none transform -rotate-3 -translate-x-6">
      DEPILADORA IPL PRO
    </div>
  </div>

  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center">
      <!-- Left Visual (Dual Device 3D Presentation) -->
      <div class="lg:col-span-6 flex justify-center items-center relative">
        <div class="relative w-full max-w-md sm:max-w-lg aspect-square flex items-center justify-center">
          <!-- Ambient Glow -->
          <div class="absolute inset-0 bg-white/20 rounded-full filter blur-3xl transform scale-75 animate-pulse"></div>

          {%- if section.settings.image != blank -%}
            <img
              src="{{ section.settings.image | image_url: width: 1000 }}"
              alt="{{ section.settings.image.alt | default: 'Depiladora IPL Pro ShinnySkin' }}"
              class="relative z-10 w-full h-full object-contain drop-shadow-2xl animate-float"
              width="600"
              height="600"
              loading="eager"
            >
          {%- else -%}
            <img
              src="{{ 'hero-handsets.jpg' | asset_url }}"
              alt="Depiladora IPL Pro ShinnySkin"
              class="relative z-10 w-full h-full object-contain rounded-3xl drop-shadow-2xl animate-float"
              width="600"
              height="600"
              loading="eager"
            >
          {%- endif -%}
        </div>
      </div>

      <!-- Right Content Area -->
      <div class="lg:col-span-6 space-y-6 text-left">
        <!-- Review Rating Pill Badge -->
        <div class="inline-flex items-center gap-2 bg-white/20 backdrop-blur-md border border-white/30 px-3.5 py-1.5 rounded-full text-xs font-bold text-white shadow-sm">
          <span class="w-2.5 h-2.5 rounded-full bg-emerald-400 animate-pulse"></span>
          <span>{{ section.settings.badge_text | default: '4.9/5 - MÁS DE 50,000 CLIENTES SATISFECHAS' }}</span>
        </div>

        <!-- Main Headline -->
        <h1 class="font-heading text-4xl sm:text-5xl lg:text-6xl font-extrabold text-white leading-[1.1] tracking-tight">
          {{ section.settings.heading | default: 'Depilación permanente con ShinnySkin' }}
        </h1>

        <!-- CTA & Circular Seal Badge Row -->
        <div class="pt-2 flex flex-wrap items-center gap-5">
          <a
            href="{{ section.settings.button_link | default: '/collections/all' }}"
            class="btn-primary px-8 sm:px-10 py-4 text-xs sm:text-sm font-extrabold uppercase tracking-wider bg-[#111111] hover:bg-[#222222] text-white shadow-2xl rounded-full transform hover:scale-105 transition-all flex items-center justify-center gap-2"
          >
            <span>{{ section.settings.button_text | default: 'COMPRA CON 50% DE DESCUENTO' }}</span>
            {% render 'icon-arrow-right', class: 'w-4 h-4' %}
          </a>

          <!-- Circular Guarantee Badge Seal -->
          <div class="relative w-16 h-16 sm:w-20 sm:h-20 rounded-full border-2 border-white/40 bg-white/10 backdrop-blur-md p-1 flex items-center justify-center text-center shadow-lg transform rotate-6 hover:rotate-0 transition-transform">
            <div class="w-full h-full rounded-full border border-dashed border-white/60 flex flex-col items-center justify-center">
              <span class="text-[9px] sm:text-[10px] font-extrabold leading-none uppercase">Garantía</span>
              <span class="text-xs sm:text-sm font-black text-amber-300">90 DÍAS</span>
              <span class="text-[8px] font-medium opacity-90">100% Seguro</span>
            </div>
          </div>
        </div>

        <!-- 3 Value Bullet Points -->
        <div class="space-y-3 pt-3 border-t border-white/20">
          <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-white/95">
            <span class="text-emerald-300 text-base">🔒</span>
            <span>Compra 100% segura y protegida con garantía total</span>
          </div>
          <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-white/95">
            <span class="text-amber-300 text-base">🚚</span>
            <span>Envío gratis a todo el país + rastreo en tiempo real</span>
          </div>
          <div class="flex items-center gap-3 text-xs sm:text-sm font-medium text-white/95">
            <span class="text-pink-200 text-base">⭐</span>
            <span>Resultados visibles en 3 a 4 semanas sin dolor ni irritación</span>
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Hero IPL Showcase",
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Hero Product Image"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "4.9/5 - MÁS DE 50,000 CLIENTES SATISFECHAS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Main Heading",
      "default": "Depilación permanente con ShinnySkin"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "COMPRA CON 50% DE DESCUENTO"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Hero IPL Showcase"
    }
  ]
}
{% endschema %}
