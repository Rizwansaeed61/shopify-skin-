{% comment %}
  Main Cart Page Section OS 2.0
{% endcomment %}

<section class="main-cart py-12 md:py-20 bg-[#FFF7F9]">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 lg:px-8">
    <h1 class="font-heading text-3xl sm:text-4xl font-extrabold text-gray-900 tracking-tight mb-8 text-center">
      {{ 'sections.cart.title' | t | default: 'Tu Carrito de Compras' }}
    </h1>

    {%- if cart.item_count > 0 -%}
      <div class="bg-white rounded-3xl p-6 sm:p-8 shadow-sm border border-[#F3E2E8] space-y-6">
        <!-- Items -->
        <div class="space-y-4">
          {%- for item in cart.items -%}
            <div class="flex items-center gap-4 pb-4 border-b border-gray-100 last:border-0">
              <div class="w-20 h-20 rounded-2xl bg-[#FFF8FA] border border-[#F3E2E8] flex-shrink-0 overflow-hidden">
                {%- if item.image -%}
                  <img src="{{ item.image | image_url: width: 160 }}" alt="{{ item.title }}" class="w-full h-full object-contain p-2">
                {%- endif -%}
              </div>
              <div class="flex-1">
                <h3 class="text-sm font-bold text-gray-900">{{ item.product.title }}</h3>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="text-xs text-gray-500">{{ item.variant.title }}</p>
                {%- endunless -%}
                <p class="text-xs font-bold text-[#E86B91] mt-1">{{ item.final_line_price | money }}</p>
              </div>
              <div class="text-xs font-semibold text-gray-600">
                Cant: {{ item.quantity }}
              </div>
            </div>
          {%- endfor -%}
        </div>

        <!-- Subtotal and checkout -->
        <div class="pt-6 border-t border-gray-100 flex flex-col sm:flex-row items-center justify-between gap-4">
          <div>
            <span class="text-xs text-gray-500 uppercase tracking-wider block">Total de la orden</span>
            <span class="text-2xl font-black text-gray-900">{{ cart.total_price | money }}</span>
          </div>
          <a href="/checkout" class="w-full sm:w-auto btn-primary px-10 py-4 text-xs font-bold uppercase tracking-wider bg-[#111111] hover:bg-[#333333] text-white rounded-full shadow-lg">
            {{ 'sections.cart.checkout' | t | default: 'Finalizar Compra Segura' }}
          </a>
        </div>
      </div>
    {%- else -%}
      <div class="bg-white rounded-3xl p-12 text-center shadow-sm border border-[#F3E2E8] space-y-4">
        <p class="text-base text-gray-700 font-semibold">{{ 'sections.cart.empty' | t | default: 'Tu carrito está actualmente vacío' }}</p>
        <a href="/" class="btn-primary px-8 py-3.5 text-xs font-bold uppercase rounded-full inline-block">
          {{ 'sections.cart.continue_shopping' | t | default: 'Continuar Comprando' }}
        </a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "Main Cart Page",
  "settings": []
}
{% endschema %}
