{% comment %}
  Combined Newsletter and Footer Section matching bottom of design
{% endcomment %}

<footer class="site-footer bg-[#FCEAEF] border-t border-[#F7D5DF] pt-16 pb-10 text-gray-800">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 pb-12 border-b border-[#F0DFE5]">
      <!-- Left Column: Newsletter & Social (5 Cols) -->
      <div class="lg:col-span-5 space-y-6">
        <div>
          <h3 class="font-heading text-2xl sm:text-3xl font-extrabold text-gray-900 tracking-tight">
            Suscríbete y entérate de todo
          </h3>
          <p class="text-xs text-gray-600 mt-2 leading-relaxed max-w-md">
            Al suscribirte aceptas recibir novedades y ofertas exclusivas de ShinnySkin. Puedes cancelar tu suscripción en cualquier momento.
          </p>
        </div>

        <!-- Sleek Email Input Pill -->
        {% form 'customer', class: 'max-w-md relative' %}
          <input type="hidden" name="contact[tags]" value="newsletter">
          {%- if form.posted_successfully? -%}
            <div class="p-3 bg-emerald-50 text-emerald-800 rounded-2xl text-xs font-semibold border border-emerald-200">
              🎉 ¡Gracias por suscribirte!
            </div>
          {%- else -%}
            <div class="relative flex items-center">
              <input
                type="email"
                name="contact[email]"
                value="{{ form.email }}"
                placeholder="Ingresa tu correo electrónico"
                class="w-full pl-5 pr-12 py-3.5 rounded-full bg-white text-gray-900 placeholder-gray-400 text-xs shadow-sm focus:outline-none focus:ring-2 focus:ring-[#E86B91] border border-[#F0DFE5]"
                required
              >
              <button
                type="submit"
                class="absolute right-2 w-8 h-8 rounded-full bg-[#111111] hover:bg-[#333333] text-white flex items-center justify-center transition-colors shadow-sm focus:outline-none"
                aria-label="Suscribirse"
              >
                {% render 'icon-arrow-right', class: 'w-3.5 h-3.5' %}
              </button>
            </div>
          {%- endif -%}
        {% endform %}

        <!-- Social Links -->
        <div class="pt-2">
          {% render 'social-icons', class: 'justify-start' %}
        </div>
      </div>

      <!-- Right 4 Nav Columns (7 Cols) -->
      <div class="lg:col-span-7 grid grid-cols-2 sm:grid-cols-4 gap-6">
        <!-- Col 1: ShinnySkin -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900">
            ShinnySkin
          </h4>
          <ul class="space-y-2 text-xs text-gray-600">
            <li><a href="/" class="hover:text-[#E86B91] transition-colors">Inicio</a></li>
            <li><a href="/pages/nosotros" class="hover:text-[#E86B91] transition-colors">Nuestra Historia</a></li>
            <li><a href="#como-funciona" class="hover:text-[#E86B91] transition-colors">¿Cómo Funciona?</a></li>
            <li><a href="/pages/faq" class="hover:text-[#E86B91] transition-colors">Preguntas Frecuentes</a></li>
          </ul>
        </div>

        <!-- Col 2: Complementos -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900">
            Complementos
          </h4>
          <ul class="space-y-2 text-xs text-gray-600">
            <li><a href="/collections/all" class="hover:text-[#E86B91] transition-colors">Depiladora IPL Pro</a></li>
            <li><a href="/collections/all" class="hover:text-[#E86B91] transition-colors">Mini Shaver Facial</a></li>
            <li><a href="/collections/all" class="hover:text-[#E86B91] transition-colors">Geles Conductores</a></li>
            <li><a href="/collections/all" class="hover:text-[#E86B91] transition-colors">Kits Completos</a></li>
          </ul>
        </div>

        <!-- Col 3: Tu Piel -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900">
            Tu Piel
          </h4>
          <ul class="space-y-2 text-xs text-gray-600">
            <li><a href="/pages/tonos-de-piel" class="hover:text-[#E86B91] transition-colors">Guía de Tonos</a></li>
            <li><a href="#testimoniales" class="hover:text-[#E86B91] transition-colors">Resultados</a></li>
            <li><a href="/pages/rutina" class="hover:text-[#E86B91] transition-colors">Rutina de Cuidado</a></li>
          </ul>
        </div>

        <!-- Col 4: Ayuda -->
        <div class="space-y-3">
          <h4 class="text-xs font-bold uppercase tracking-wider text-gray-900">
            Ayuda
          </h4>
          <ul class="space-y-2 text-xs text-gray-600">
            <li><a href="/pages/envios" class="hover:text-[#E86B91] transition-colors">Tiempos de Envío</a></li>
            <li><a href="/pages/garantia" class="hover:text-[#E86B91] transition-colors">Garantía de 90 Días</a></li>
            <li><a href="/policies/privacy-policy" class="hover:text-[#E86B91] transition-colors">Políticas de Privacidad</a></li>
            <li><a href="/policies/terms-of-service" class="hover:text-[#E86B91] transition-colors">Términos del Servicio</a></li>
          </ul>
        </div>
      </div>
    </div>

    <!-- Bottom Row -->
    <div class="pt-8 flex flex-col sm:flex-row items-center justify-between gap-4 text-[11px] text-gray-500">
      <p>© {{ 'now' | date: '%Y' }} ShinnySkin. Todos los derechos reservados.</p>
      <div class="flex items-center gap-4">
        <span>Visa</span>
        <span>Mastercard</span>
        <span>PayPal</span>
        <span>MercadoPago</span>
        <span>SSL 256-Bit</span>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Footer",
  "settings": []
}
{% endschema %}
