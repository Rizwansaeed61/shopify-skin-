{% comment %}
  Instagram & TikTok UGC Social Feed Section (@MyShinnySkin) (Exact 1:1 Match to Design)
{% endcomment %}

<section class="social-ugc py-16 md:py-24 bg-white" data-carousel-container>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Handle Link -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
          {{ section.settings.tag | default: 'COMUNIDAD SHINNYSKIN' }}
        </span>
        <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight italic">
          <a href="{{ settings.social_instagram_link | default: 'https://instagram.com/myshinnyskin' }}" target="_blank" rel="noopener noreferrer" class="hover:text-[#E86B91] transition-colors">
            {{ section.settings.heading | default: '@MyShinnySkin' }}
          </a>
        </h2>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-prev
          aria-label="Anterior"
        >
          {% render 'icon-arrow-left' %}
        </button>
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-next
          aria-label="Siguiente"
        >
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>

    <!-- 6-Item UGC Carousel Track -->
    <div
      class="flex gap-4 sm:gap-6 overflow-x-auto no-scrollbar pb-6 scroll-smooth"
      data-carousel-track
    >
      <!-- Reel 1 (Red Flag) -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-[#FF3366] text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <div class="self-end bg-black/40 p-1.5 rounded-full text-xs">▶</div>
        <div class="space-y-1">
          <span class="bg-white/20 text-[9px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider">Reel</span>
          <p class="text-white text-xs font-black leading-snug">
            🚩 Red flags en métodos de depilación
          </p>
        </div>
      </div>

      <!-- Reel 2 -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-slate-900 text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <img src="{{ 'blog-underarm.jpg' | asset_url }}" alt="Depilación fácil" class="absolute inset-0 w-full h-full object-cover opacity-80" loading="lazy">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-0"></div>
        <div class="self-end bg-black/40 text-white p-1.5 rounded-full relative z-10 text-xs">▶</div>
        <div class="relative z-10">
          <p class="text-white text-xs font-extrabold leading-snug">
            ✨ Depilación fácil y sin dolor
          </p>
        </div>
      </div>

      <!-- Reel 3 -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-slate-900 text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <img src="{{ 'how-it-works-girl.jpg' | asset_url }}" alt="Mi secreto" class="absolute inset-0 w-full h-full object-cover opacity-80" loading="lazy">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-0"></div>
        <div class="self-end bg-black/40 text-white p-1.5 rounded-full relative z-10 text-xs">▶</div>
        <div class="relative z-10">
          <p class="text-white text-xs font-extrabold leading-snug">
            🌸 Mi secreto para piel de porcelana
          </p>
        </div>
      </div>

      <!-- Reel 4 (Blue Graphic) -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-[#00B4D8] text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <div class="self-end bg-black/40 p-1.5 rounded-full text-xs">▶</div>
        <div class="space-y-1">
          <span class="bg-white/20 text-[9px] font-bold px-2 py-0.5 rounded-md uppercase tracking-wider">Tips</span>
          <p class="text-white text-xs font-black leading-snug">
            💡 Qué pasa realmente cuando se depilan
          </p>
        </div>
      </div>

      <!-- Reel 5 -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-slate-900 text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <img src="{{ 'blog-leg.jpg' | asset_url }}" alt="Cambié a ShinnySkin" class="absolute inset-0 w-full h-full object-cover opacity-80" loading="lazy">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-0"></div>
        <div class="self-end bg-black/40 text-white p-1.5 rounded-full relative z-10 text-xs">▶</div>
        <div class="relative z-10">
          <p class="text-white text-xs font-extrabold leading-snug">
            💆‍♀️ Cambié a esto y adiós dolor
          </p>
        </div>
      </div>

      <!-- Reel 6 -->
      <div class="w-48 sm:w-56 flex-shrink-0 group relative rounded-3xl overflow-hidden aspect-[9/16] bg-slate-900 text-white flex flex-col justify-between p-4 shadow-md hover:scale-105 transition-transform cursor-pointer">
        <img src="{{ 'blog-white-handset.jpg' | asset_url }}" alt="Rutina de domingo" class="absolute inset-0 w-full h-full object-cover opacity-80" loading="lazy">
        <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-transparent z-0"></div>
        <div class="self-end bg-black/40 text-white p-1.5 rounded-full relative z-10 text-xs">▶</div>
        <div class="relative z-10">
          <p class="text-white text-xs font-extrabold leading-snug">
            🧖‍♀️ Rutina de domingo relajada
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Social UGC Reels",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "COMUNIDAD SHINNYSKIN"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "@MyShinnySkin"
    }
  ],
  "presets": [
    {
      "name": "Social UGC Reels"
    }
  ]
}
{% endschema %}
