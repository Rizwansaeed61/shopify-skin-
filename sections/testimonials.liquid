{% comment %}
  Testimonials UGC Customer Reviews Carousel Section (Exact 1:1 Match to Design)
{% endcomment %}

<section id="testimoniales" class="testimonials py-16 md:py-24 bg-[#FFF7F9]" data-carousel-container>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <!-- Header with Nav Arrows -->
    <div class="flex items-end justify-between mb-10">
      <div>
        <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
          {{ section.settings.tag | default: 'CLIENTES FELICES' }}
        </span>
        <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight">
          {{ section.settings.heading | default: 'Testimoniales' }}
        </h2>
      </div>

      <!-- Arrow Controls -->
      <div class="flex items-center gap-2">
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-prev
          aria-label="Anterior"
        >
          {% render 'icon-arrow-left' %}
        </button>
        <button
          type="button"
          class="w-10 h-10 rounded-full bg-white border border-[#F3E2E8] hover:border-[#E86B91] hover:text-[#E86B91] text-gray-700 flex items-center justify-center shadow-sm transition-all focus:outline-none"
          data-carousel-next
          aria-label="Siguiente"
        >
          {% render 'icon-arrow-right' %}
        </button>
      </div>
    </div>

    <!-- Testimonials Track -->
    <div
      class="flex gap-6 overflow-x-auto no-scrollbar pb-6 scroll-smooth"
      data-carousel-track
    >
      <!-- Review 1 -->
      <div class="w-72 sm:w-80 flex-shrink-0 bg-white rounded-3xl overflow-hidden border border-[#F3E2E8] shadow-sm flex flex-col">
        <div class="relative w-full aspect-[4/3] bg-[#FCEAEF] overflow-hidden p-3 flex items-center justify-center">
          <img src="{{ 'hero-handsets.jpg' | asset_url }}" alt="Gloria T." class="w-full h-full object-cover rounded-2xl" loading="lazy">
        </div>
        <div class="p-5 space-y-2">
          <div class="flex text-[#FFB800]">
            {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
          </div>
          <div class="flex items-center gap-1.5">
            <h4 class="text-sm font-bold text-gray-900">Gloria T.</h4>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">✓ Verificada</span>
          </div>
          <p class="text-xs text-gray-600 italic leading-relaxed">
            "¡Increíble! En 4 semanas ya noté que el vello crecía súper lento y delgado. Cero dolor y súper fácil de usar."
          </p>
        </div>
      </div>

      <!-- Review 2 -->
      <div class="w-72 sm:w-80 flex-shrink-0 bg-white rounded-3xl overflow-hidden border border-[#F3E2E8] shadow-sm flex flex-col">
        <div class="relative w-full aspect-[4/3] bg-[#FCEAEF] overflow-hidden p-3 flex items-center justify-center">
          <img src="{{ 'blog-white-handset.jpg' | asset_url }}" alt="Andrea M." class="w-full h-full object-cover rounded-2xl" loading="lazy">
        </div>
        <div class="p-5 space-y-2">
          <div class="flex text-[#FFB800]">
            {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
          </div>
          <div class="flex items-center gap-1.5">
            <h4 class="text-sm font-bold text-gray-900">Andrea M.</h4>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">✓ Verificada</span>
          </div>
          <p class="text-xs text-gray-600 italic leading-relaxed">
            "No duele nada en comparación con la cera. Súper recomendada especialmente para axilas y piernas."
          </p>
        </div>
      </div>

      <!-- Review 3 -->
      <div class="w-72 sm:w-80 flex-shrink-0 bg-white rounded-3xl overflow-hidden border border-[#F3E2E8] shadow-sm flex flex-col">
        <div class="relative w-full aspect-[4/3] bg-[#FCEAEF] overflow-hidden p-3 flex items-center justify-center">
          <img src="{{ 'blog-leg.jpg' | asset_url }}" alt="Diana R." class="w-full h-full object-cover rounded-2xl" loading="lazy">
        </div>
        <div class="p-5 space-y-2">
          <div class="flex text-[#FFB800]">
            {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
          </div>
          <div class="flex items-center gap-1.5">
            <h4 class="text-sm font-bold text-gray-900">Diana R.</h4>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">✓ Verificada</span>
          </div>
          <p class="text-xs text-gray-600 italic leading-relaxed">
            "El mejor dinero invertido en mi cuidado personal. Piel suave sin foliculitis ni vellos enterrados."
          </p>
        </div>
      </div>

      <!-- Review 4 -->
      <div class="w-72 sm:w-80 flex-shrink-0 bg-white rounded-3xl overflow-hidden border border-[#F3E2E8] shadow-sm flex flex-col">
        <div class="relative w-full aspect-[4/3] bg-[#FCEAEF] overflow-hidden p-3 flex items-center justify-center">
          <img src="{{ 'how-it-works-girl.jpg' | asset_url }}" alt="Camila V." class="w-full h-full object-cover rounded-2xl" loading="lazy">
        </div>
        <div class="p-5 space-y-2">
          <div class="flex text-[#FFB800]">
            {%- for i in (1..5) -%}{% render 'icon-star' %}{%- endfor -%}
          </div>
          <div class="flex items-center gap-1.5">
            <h4 class="text-sm font-bold text-gray-900">Camila V.</h4>
            <span class="text-[10px] font-bold text-emerald-600 bg-emerald-50 px-2 py-0.5 rounded-full">✓ Verificada</span>
          </div>
          <p class="text-xs text-gray-600 italic leading-relaxed">
            "Práctica, bonita y los resultados son reales. El servicio al cliente por WhatsApp también es de 10."
          </p>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "Customer Testimonials",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "CLIENTES FELICES"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Testimoniales"
    }
  ],
  "presets": [
    {
      "name": "Customer Testimonials"
    }
  ]
}
{% endschema %}
