{% comment %}
  Press & Media Reviews Ticker Section (Exact 1:1 Design)
{% endcomment %}

<div class="press-ticker py-6 border-y border-[#F3E2E8] bg-white relative overflow-hidden">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 items-center">
      <!-- Item 1 -->
      <div class="text-center p-3 border-r border-gray-100 last:border-0 space-y-1.5">
        <p class="text-[11px] sm:text-xs text-gray-500 italic leading-snug">
          "La depiladora IPL más recomendada para usar en casa"
        </p>
        <h4 class="font-serif text-sm sm:text-base font-black tracking-widest text-gray-900 uppercase">
          COSMOPOLITAN
        </h4>
      </div>

      <!-- Item 2 -->
      <div class="text-center p-3 border-r border-gray-100 last:border-0 space-y-1.5">
        <p class="text-[11px] sm:text-xs text-gray-500 italic leading-snug">
          "Resultados de clínica estética sin salir de tu habitación"
        </p>
        <h4 class="font-serif text-sm sm:text-base font-black tracking-widest text-gray-900 uppercase">
          VOGUE
        </h4>
      </div>

      <!-- Item 3 -->
      <div class="text-center p-3 border-r border-gray-100 last:border-0 space-y-1.5">
        <p class="text-[11px] sm:text-xs text-gray-500 italic leading-snug">
          "Dile adiós a la cera y a los rastrillos para siempre"
        </p>
        <h4 class="font-serif text-sm sm:text-base font-black tracking-widest text-gray-900 uppercase">
          GLAMOUR
        </h4>
      </div>

      <!-- Item 4 -->
      <div class="text-center p-3 space-y-1.5">
        <p class="text-[11px] sm:text-xs text-gray-500 italic leading-snug">
          "La favorita indiscutible de las expertas de belleza"
        </p>
        <h4 class="font-serif text-sm sm:text-base font-black tracking-widest text-gray-900 uppercase">
          ELLE
        </h4>
      </div>
    </div>
  </div>
</div>

