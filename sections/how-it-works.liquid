{% comment %}
  How It Works Section (Exact 1:1 Match to Design)
{% endcomment %}

<section id="como-funciona" class="how-it-works py-16 md:py-24 bg-white">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-12 lg:gap-16 items-center">
      <!-- Left Steps Column -->
      <div class="lg:col-span-6 space-y-8">
        <div>
          <span class="text-xs font-bold uppercase tracking-widest text-[#E86B91] block mb-2">
            {{ section.settings.tag | default: 'APRENDE EN 3 PASOS' }}
          </span>
          <h2 class="font-heading text-4xl sm:text-5xl font-extrabold text-gray-900 tracking-tight italic">
            {{ section.settings.heading | default: '¿Cómo funciona?' }}
          </h2>
        </div>

        <!-- 3 Step Items -->
        <div class="space-y-6">
          <!-- Step 1 -->
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#FFF0F4] border border-[#F7D5DF] text-[#E86B91] flex items-center justify-center font-bold text-base shadow-sm">
              1
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-gray-900">
                Rasura el área antes de usar el dispositivo
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                Asegúrate de que la piel esté completamente limpia y seca para que la luz pulsada viaje directo a la raíz del folículo.
              </p>
            </div>
          </div>

          <!-- Step 2 -->
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#FFF0F4] border border-[#F7D5DF] text-[#E86B91] flex items-center justify-center font-bold text-base shadow-sm">
              2
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-gray-900">
                Selecciona el nivel de intensidad adecuado
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                Cuenta con 5 niveles de potencia ajustables según tu tono de piel y nivel de sensibilidad para un tratamiento 100% cómodo.
              </p>
            </div>
          </div>

          <!-- Step 3 -->
          <div class="flex items-start gap-4">
            <div class="flex-shrink-0 w-10 h-10 rounded-full bg-[#FFF0F4] border border-[#F7D5DF] text-[#E86B91] flex items-center justify-center font-bold text-base shadow-sm">
              3
            </div>
            <div class="space-y-1">
              <h3 class="text-base font-bold text-gray-900">
                Coloca el cabezal a 90° y presiona el botón
              </h3>
              <p class="text-xs sm:text-sm text-gray-600 leading-relaxed">
                Desliza sobre la piel aplicando los pulsos. Solo toma de 15 a 20 minutos por sesión una sola vez a la semana.
              </p>
            </div>
          </div>
        </div>

        <div class="pt-2">
          <a
            href="{{ section.settings.button_link | default: '/collections/all' }}"
            class="btn-primary px-8 py-3.5 text-xs font-bold uppercase tracking-wider bg-[#111111] hover:bg-[#333333] text-white rounded-full shadow-lg"
          >
            {{ section.settings.button_text | default: 'COMPRAR AHORA' }}
          </a>
        </div>
      </div>

      <!-- Right Video Card Frame -->
      <div class="lg:col-span-6">
        <div class="relative rounded-3xl overflow-hidden shadow-2xl border-4 border-white aspect-[4/3] group bg-[#FCEAEF]">
          {%- if section.settings.video_poster != blank -%}
            <img
              src="{{ section.settings.video_poster | image_url: width: 800 }}"
              alt="Demostración ShinnySkin"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              width="600"
              height="450"
            >
          {%- else -%}
            <img
              src="{{ 'how-it-works-girl.jpg' | asset_url }}"
              alt="Demostración ShinnySkin"
              class="w-full h-full object-cover transition-transform duration-700 group-hover:scale-105"
              width="600"
              height="450"
            >
          {%- endif -%}

          <!-- Glowing Play Button -->
          <button
            type="button"
            class="absolute inset-0 m-auto w-20 h-20 rounded-full bg-white text-[#E86B91] hover:text-[#D43B65] shadow-2xl flex items-center justify-center pulse-glow transform group-hover:scale-110 transition-transform focus:outline-none"
            data-video-url="{{ section.settings.video_url | default: 'https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1' }}"
            aria-label="Reproducir video de demostración"
          >
            <svg class="w-8 h-8 ml-1" viewBox="0 0 24 24" fill="currentColor">
              <polygon points="6 3 20 12 6 21 6 3"></polygon>
            </svg>
          </button>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "How It Works",
  "settings": [
    {
      "type": "text",
      "id": "tag",
      "label": "Tag",
      "default": "APRENDE EN 3 PASOS"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "¿Cómo funciona?"
    },
    {
      "type": "image_picker",
      "id": "video_poster",
      "label": "Custom Video Poster"
    },
    {
      "type": "text",
      "id": "video_url",
      "label": "Video Embed URL",
      "default": "https://www.youtube.com/embed/dQw4w9WgXcQ?autoplay=1"
    },
    {
      "type": "text",
      "id": "button_text",
      "label": "Button Text",
      "default": "COMPRAR AHORA"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "How It Works"
    }
  ]
}
{% endschema %}
