{% comment %}
  Announcement Bar Section
{% endcomment %}

{%- if section.settings.show_announcement -%}
  <div class="announcement-bar relative z-50 bg-[#E86B91] text-white text-xs font-semibold py-2.5 px-4 shadow-sm" style="background-color: {{ section.settings.bg_color }}; color: {{ section.settings.text_color }};">
    <div class="max-w-7xl mx-auto flex items-center justify-between gap-4">
      <div class="hidden md:flex items-center gap-2 flex-1 justify-start">
        {%- if section.blocks.size > 0 -%}
          {%- assign first_block = section.blocks[0] -%}
          <span class="flex items-center gap-1.5 opacity-90">
            {{ first_block.settings.text }}
          </span>
        {%- endif -%}
      </div>

      <div class="flex-1 text-center font-bold tracking-wide">
        {%- if section.blocks.size > 1 -%}
          {%- assign center_block = section.blocks[1] -%}
          <span class="inline-flex items-center gap-1.5">
            {{ center_block.settings.text }}
          </span>
        {%- elsif section.blocks.size == 1 -%}
          <span>{{ section.blocks[0].settings.text }}</span>
        {%- else -%}
          <span>🚚 Envío Gratis a todo el país en pedidos mayores a $50</span>
        {%- endif -%}
      </div>

      <div class="hidden md:flex items-center gap-2 flex-1 justify-end">
        {%- if section.blocks.size > 2 -%}
          {%- assign third_block = section.blocks[2] -%}
          <span class="flex items-center gap-1.5 opacity-90">
            {{ third_block.settings.text }}
          </span>
        {%- endif -%}
      </div>
    </div>
  </div>
{%- endif -%}

{% schema %}
{
  "name": "Announcement Bar",
  "settings": [
    {
      "type": "checkbox",
      "id": "show_announcement",
      "label": "Show Announcement Bar",
      "default": true
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Background Color",
      "default": "#E86B91"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FFFFFF"
    }
  ],
  "blocks": [
    {
      "type": "announcement",
      "name": "Announcement Message",
      "settings": [
        {
          "type": "text",
          "id": "text",
          "label": "Text",
          "default": "🚚 Envío gratis a todo el país"
        },
        {
          "type": "url",
          "id": "link",
          "label": "Optional Link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Announcement Bar",
      "blocks": [
        {
          "type": "announcement",
          "settings": {
            "text": "🚚 Envío gratis en todas las compras"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "✨ Garantía de resultados por 90 días"
          }
        },
        {
          "type": "announcement",
          "settings": {
            "text": "💳 Paga a cuotas sin interés"
          }
        }
      ]
    }
  ]
}
{% endschema %}
